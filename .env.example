# ==============================================================================
# OFCL — Osservatorio Finanze Comunali del Locarnese
# Template Variabili d'Ambiente (.env.example)
#
# ⚠️ GUARDRAIL C-01: VIETATO inserire l'URL del progetto Corfin (vrqnbdcsavgpdgijpiic)!
# Usa esclusivamente il progetto dedicato 'ofcl-prod' (Zurigo) o Supabase locale.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE / POSTGRESQL (Progetto dedicato 'ofcl-prod' - eu-central-2 Zurigo)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<TUO_PROJECT_REF_OFCL>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<TUA_ANON_KEY_OFCL>"
SUPABASE_SERVICE_ROLE_KEY="<TUA_SERVICE_ROLE_KEY_OFCL>"
DATABASE_URL="postgresql://postgres:<PASSWORD>@db.<TUO_PROJECT_REF_OFCL>.supabase.co:5432/postgres"

# Alternativa Locale Docker (`npx supabase start`):
# NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 (Archivio immutabile PDF SHA-256 a zero costi di egress)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="<TUO_CLOUDFLARE_ACCOUNT_ID>"
R2_BUCKET_NAME="ofcl-raw-pdfs"
R2_ACCESS_KEY_ID="<TUA_R2_ACCESS_KEY_ID>"
R2_SECRET_ACCESS_KEY="<TUA_R2_SECRET_ACCESS_KEY>"
R2_ENDPOINT_URL="https://<TUO_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com"

# ------------------------------------------------------------------------------
# 3. CRAWLER & PIPELINE PYTHON
# ------------------------------------------------------------------------------
OFCL_BOT_USER_AGENT="OFCL-Bot/1.0 (+https://ofcl.ch/bot; info@ofcl.ch)"
OFCL_ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# 4. WEBHOOK CACHE REVALIDATION & DEPLOYMENT (GitHub Actions <-> Vercel)
# ------------------------------------------------------------------------------
REVALIDATE_SECRET="<TOKEN_SEGRETO_32_BYTE_HEX>"
SITE_URL="https://ofcl.ch"
